PUID=1000
PGID=1000
TZ=Europe/Istanbul

HOMARR_PORT=7575
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
PROWLARR_PORT=9696
BAZARR_PORT=6767
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_BT_PORT=6881
EMBY_HTTP_PORT=8096
SEERR_PORT=5055

CONFIG_ROOT=./config
MEDIA_MOVIES_DIR=./media/movies
MEDIA_TV_DIR=./media/tv
MEDIA_MUSIC_DIR=./media/music
DOWNLOADS_ROOT=./downloads
WATCHTOWER_NOTIFICATIONS=

# arr-setup: login used for every web UI (Sonarr/Radarr/Lidarr/Prowlarr/qBittorrent/Bazarr/Emby)
STACK_USER=admin
STACK_PASSWORD=changeme
# Prowlarr indexer definition names, comma separated (e.g. yts,eztv). Empty = skip
PROWLARR_INDEXERS=yts,eztv,1337x,thepiratebay,limetorrents,nyaasi,internetarchive
# Bazarr subtitle languages (ISO 639-1), first one is preferred
SUBTITLE_LANGUAGES=tr,en
